# Copy to .env.server on the review server. Do not commit the copied file.
# This profile intentionally uses HTTP and DJANGO_ENVIRONMENT=development for
# a temporary review deployment. Do not use it as a production baseline.

SERVER_HOST=203.0.113.10
PUBLIC_ORIGIN=http://203.0.113.10:3000
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
# Exact tag of the prebuilt frontend image loaded with `docker load`.
FRONTEND_IMAGE=dentotime-frontend:release-YYYYMMDD-HHMM

DJANGO_ENVIRONMENT=development
DEBUG=False
REFRESH_THROTTLE_RATE=120/min
SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
OTP_HASH_KEY=replace-with-a-third-long-random-secret
CAPTCHA_HASH_KEY=replace-with-a-fourth-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,backend,203.0.113.10
CORS_ALLOWED_ORIGINS=http://203.0.113.10:3000
CSRF_TRUSTED_ORIGINS=http://203.0.113.10:3000
MINIO_CORS_ALLOWED_ORIGINS=http://203.0.113.10:3000

DB_NAME=dentotime
DB_USER=dentotime
DB_PASS=replace-with-a-long-random-database-password
POSTGRES_HOST_PORT=55432

REDIS_HOST_PORT=6379

AWS_ACCESS_KEY_ID=dentotime-review-storage
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-storage-password
AWS_STORAGE_BUCKET_NAME=dentotime-review-private
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SERVER_SIDE_ENCRYPTION=
# Browser-visible endpoint used in presigned upload/download URLs.
AWS_S3_PUBLIC_ENDPOINT_URL=http://203.0.113.10:9000
MINIO_BIND_ADDRESS=0.0.0.0
MINIO_CONSOLE_PORT=9001

# Optional bootstrap account. Use a unique 14+ character password and remove
# these values after the first successful migration.
SYSTEM_ADMIN_PHONE=+989120000001
SYSTEM_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password

# There is no trusted reverse proxy in this HTTP-only setup. Uvicorn will not
# trust client-supplied X-Forwarded-* headers. Keep this at 127.0.0.1.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# The Compose file always runs the file-scanner worker. This temporary
# development profile uses its deterministic built-in scanner. Production
# defaults to REQUIRE_CLAMAV=True and must set CLAMAV_HOST to a private clamd.
REQUIRE_CLAMAV=False
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
