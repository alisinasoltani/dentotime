# Copy this file to .env.server on the server and replace every placeholder.
# This profile is for the current HTTP deployment on 95.38.185.165.
# Never commit .env.server or real secrets.

SERVER_HOST=95.38.185.165
PUBLIC_ORIGIN=http://95.38.185.165:3000
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000
BACKEND_HOST_PORT=8000

DJANGO_ENVIRONMENT=development
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
OTP_HASH_KEY=replace-with-a-third-independent-long-random-key
CAPTCHA_HASH_KEY=replace-with-a-fourth-independent-long-random-key
JWT_ISSUER=dentotime-api
ALLOWED_HOSTS=localhost,127.0.0.1,backend,95.38.185.165
CORS_ALLOWED_ORIGINS=http://95.38.185.165:3000
CSRF_TRUSTED_ORIGINS=http://95.38.185.165:3000
TRUSTED_PROXY_IPS=
CORS_ALLOW_ALL_ORIGINS=False
ENABLE_SILK=False
REFRESH_THROTTLE_RATE=120/min

DB_NAME=dentotime
DB_USER=dentotime
DB_PASS=replace-with-a-long-random-database-password
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
POSTGRES_HOST_PORT=55432

REDIS_URL=redis://redis:6379/1
REDIS_HOST_PORT=6379
CACHE_KEY_PREFIX=dentotime

CHAT_EVENT_STREAM_PREFIX=dentotime:chat:events
CHAT_EVENT_STREAM_MAX_LENGTH=10000
CHAT_SSE_BLOCK_MILLISECONDS=15000
CHAT_SSE_MAX_CONNECTION_SECONDS=540
CHAT_DELTA_PAGE_SIZE=100

SMS_IR_API_KEY=
SMS_CONNECT_TIMEOUT_SECONDS=2
SMS_READ_TIMEOUT_SECONDS=5

OTP_TTL_SECONDS=120
OTP_GRANT_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_WINDOW_SECONDS=600
OTP_PHONE_RATE_LIMIT=3
OTP_IP_RATE_LIMIT=10
OTP_DEVICE_RATE_LIMIT=5

AVAILABILITY_MAX_RANGE_DAYS=62

CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_RATE_WINDOW_SECONDS=600
CAPTCHA_IP_RATE_LIMIT=20
CAPTCHA_DEVICE_RATE_LIMIT=10

GUEST_BOOKING_RATE_WINDOW_SECONDS=3600
GUEST_BOOKING_PHONE_RATE_LIMIT=3
GUEST_BOOKING_IP_RATE_LIMIT=12
GUEST_BOOKING_DEVICE_RATE_LIMIT=6

AWS_ACCESS_KEY_ID=dentotime-storage
AWS_SECRET_ACCESS_KEY=replace-with-a-long-random-storage-password
AWS_STORAGE_BUCKET_NAME=dentotime-review-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://95.38.185.165:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SERVER_SIDE_ENCRYPTION=
AWS_S3_DOWNLOAD_EXPIRY_SECONDS=300
MINIO_CORS_ALLOWED_ORIGINS=http://95.38.185.165:3000
MINIO_BIND_ADDRESS=0.0.0.0
MINIO_CONSOLE_PORT=9001

FILE_UPLOAD_QUOTA_BYTES=5368709120
FILE_FAILED_RETENTION_DAYS=7
CHAT_FILE_RETENTION_DAYS=1095
VERIFICATION_FILE_RETENTION_DAYS=2555
PROFILE_FILE_RETENTION_DAYS=365

# ClamAV is intentionally disabled for the current deployment.
REQUIRE_CLAMAV=False
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Optional bootstrap account. The phone number must be in E.164 format.
SYSTEM_ADMIN_PHONE=+989120000001
SYSTEM_ADMIN_PASSWORD=replace-with-a-unique-14-plus-character-admin-password

# No reverse proxy is used in the current HTTP deployment.
UVICORN_FORWARDED_ALLOW_IPS=127.0.0.1
UVICORN_WORKERS=1
