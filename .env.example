# Copy to .env for local development. Never commit real values.
SECRET_KEY=replace-with-a-long-random-django-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-jwt-key
JWT_ISSUER=dentotime-api
DJANGO_ENVIRONMENT=development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False
ENABLE_SILK=False

DB_NAME=dentotime
DB_USER=dentotime
DB_PASS=replace-with-a-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=dentotime

SMS_IR_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
