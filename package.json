{
  "name": "dentotime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 92",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "playwright test tests/e2e/frontend-performance.spec.ts --project=chromium --workers=1",
    "typecheck": "tsc --noEmit",
    "analyze:bundle": "next experimental-analyze --output",
    "sbom": "npm sbom --sbom-format cyclonedx > sbom.cdx.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.21.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.0.2",
    "react-hook-form": "^7.79.0",
    "sonner": "^2.0.7",
    "swr": "2.4.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "30.0.1",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "sharp": false,
    "unrs-resolver": false
  }
}
